// ── STATE ──
let current = 0;
let score = 0;
let userAnswers = [];
let answered = false;

function startQuiz() {
  document.getElementById('intro').classList.remove('active');
  document.getElementById('quiz').classList.add('active');
  renderQuestion();
}

function renderQuestion() {
  const q = QUESTIONS[current];
  answered = false;

  // topbar
  document.getElementById('qNum').textContent = current + 1;
  document.getElementById('progressFill').style.width = ((current + 1) / QUESTIONS.length * 100) + '%';
  document.getElementById('scorePill').textContent = `PUAN: ${score} / ${current}`;

  // meta
  document.getElementById('qSection').textContent = q.section;
  document.getElementById('qTypeTag').textContent = q.type;
  document.getElementById('qBigNum').textContent = String(current + 1).padStart(2, '0');
  document.getElementById('qText').innerHTML = q.text;

  // animate card
  const card = document.getElementById('qCard');
  card.style.animation = 'none';
  void card.offsetHeight;
  card.style.animation = '';

  // choices
  const wrap = document.getElementById('choicesWrap');
  wrap.innerHTML = '';
  const letters = ['A', 'B', 'C', 'D', 'E'];
  q.choices.forEach((c, i) => {
    const div = document.createElement('div');
    div.className = 'choice';
    div.innerHTML = `
      <span class="choice-letter">${letters[i]})</span>
      <span class="choice-text">${c}</span>
      <span class="choice-icon"></span>`;
    div.onclick = () => selectAnswer(i);
    wrap.appendChild(div);
  });

  // reset feedback
  const fb = document.getElementById('feedbackBox');
  fb.className = 'feedback-box';
  fb.style.display = 'none';
  document.getElementById('btnNext').className = 'btn-next';
}

function selectAnswer(idx) {
  if (answered) return;
  answered = true;

  const q = QUESTIONS[current];
  const choices = document.querySelectorAll('.choice');
  const letters = ['A', 'B', 'C', 'D', 'E'];
  const isCorrect = idx === q.correct;

  userAnswers[current] = idx;
  if (isCorrect) score++;

  // apply styles
  choices.forEach((el, i) => {
    el.classList.add('disabled');
    if (i === q.correct) {
      el.classList.add('correct');
      el.querySelector('.choice-icon').textContent = '✓';
    } else if (i === idx && !isCorrect) {
      el.classList.add('wrong');
      el.querySelector('.choice-icon').textContent = '✗';
    } else {
      el.classList.add('dimmed');
    }
  });

  // feedback
  const fb = document.getElementById('feedbackBox');
  fb.style.display = 'block';
  if (isCorrect) {
    fb.className = 'feedback-box show';
    document.getElementById('feedbackTitle').textContent = '✓ DOĞRU CEVAP';
  } else {
    fb.className = 'feedback-box show wrong';
    document.getElementById('feedbackTitle').textContent = `✗ YANLIŞ — Doğru cevap: ${letters[q.correct]})`;
  }
  document.getElementById('feedbackText').textContent = q.explanation;

  // next button
  const btn = document.getElementById('btnNext');
  btn.className = 'btn-next show';
  btn.textContent = current < QUESTIONS.length - 1 ? 'SONRAKİ SORU →' : 'SONUÇLARI GÖR →';

  document.getElementById('scorePill').textContent = `PUAN: ${score} / ${current + 1}`;
}

function nextQuestion() {
  current++;
  if (current >= QUESTIONS.length) {
    showResults();
  } else {
    renderQuestion();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
}

function showResults() {
  document.getElementById('quiz').classList.remove('active');
  document.getElementById('results').classList.add('active');

  const pct = Math.round(score / QUESTIONS.length * 100);
  document.getElementById('resultGrade').textContent = pct + '%';

  let msg, sub;
  if (pct >= 90) {
    msg = 'Olağanüstü Performans!';
    sub = 'EHK 5809 konusunda üst düzey bilgiye sahipsiniz.';
  } else if (pct >= 75) {
    msg = 'Çok İyi!';
    sub = 'Kanuna hakimiyetiniz güçlü, birkaç konuyu pekiştirmeniz yeterli.';
  } else if (pct >= 60) {
    msg = 'Gelişime Açık';
    sub = 'Temel bilgileriniz var; ayrıntıları çalışarak puanı yükseltebilirsiniz.';
  } else {
    msg = 'Yeniden Çalışmanız Önerilir';
    sub = 'Kanunun önemli bölümlerini tekrar gözden geçirmeniz önerilir.';
  }

  document.getElementById('resultMessage').textContent = msg;
  document.getElementById('resultSub').textContent = sub;
  document.getElementById('rCorrect').textContent = score;
  document.getElementById('rWrong').textContent = QUESTIONS.length - score;
  document.getElementById('rNet').textContent = pct;
}

function showAnswerKey() {
  const ak = document.getElementById('answer-key');
  ak.classList.add('show');
  const letters = ['A', 'B', 'C', 'D', 'E'];
  let html = '';

  QUESTIONS.forEach((q, i) => {
    const userIdx = userAnswers[i];
    const isCorrect = userIdx === q.correct;
    html += `
      <div class="ak-item ${isCorrect ? 'ak-correct' : 'ak-wrong'}">
        <div class="ak-q-num">SORU ${i + 1} · ${q.section}</div>
        <div class="ak-q-text">${q.text}</div>
        <div class="ak-answer-row">
          <span class="ak-badge ${isCorrect ? 'ok' : 'your'}">Cevabınız: ${userIdx !== undefined ? letters[userIdx] + ') ' + q.choices[userIdx] : 'Cevaplanmadı'}</span>
          ${!isCorrect ? `<span class="ak-badge right">Doğru: ${letters[q.correct]}) ${q.choices[q.correct]}</span>` : ''}
        </div>
        <div class="ak-explanation">${q.explanation}</div>
      </div>`;
  });

  document.getElementById('akContent').innerHTML = html;
  ak.scrollIntoView({ behavior: 'smooth' });
}

function resetQuiz() {
  current = 0; score = 0; userAnswers = [];
  document.getElementById('results').classList.remove('active');
  document.getElementById('answer-key').classList.remove('show');
  document.getElementById('answer-key').style.display = '';
  document.getElementById('intro').classList.add('active');
  window.scrollTo({ top: 0 });
}
</script>
